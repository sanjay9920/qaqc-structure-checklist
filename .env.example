# Flask
FLASK_ENV=development
SESSION_SECRET=change-this-long-random-string
COOKIE_SECURE=false

# Public URL used inside QR codes.
# Local example: http://localhost:5000
# Deployment example: https://your-cloud-run-url.a.run.app
APP_BASE_URL=http://localhost:5000

# Firebase project
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# Local service account JSON for Firebase Admin SDK.
# Do not commit this JSON file.
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json

# Server deployment option: paste the full service account JSON into this env var.
# Use this instead of GOOGLE_APPLICATION_CREDENTIALS on Render/Railway.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated emails that can open /admin.
ADMIN_EMAILS=admin@example.com

# Used for the stored Date and Time fields in update history.
APP_TIMEZONE=Asia/Kolkata
